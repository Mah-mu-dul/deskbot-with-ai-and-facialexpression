# Copy to .env and edit.

# --- AI brain ---
# Easiest: paste your key in the dashboard (Settings > AI brain).
# Or set it here. Free Gemini key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional alternative (choose "Claude" in Settings):
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# low = fastest replies (best for voice); medium/high = more thoughtful
CLAUDE_EFFORT=low

# --- Speech ---
# tiny / base / small / medium  (bigger = more accurate, slower)
WHISPER_MODEL=base
# Leave empty for auto-detect, or force e.g. "en" or "bn"
WHISPER_LANGUAGE=
# Any edge-tts voice: en-US-AriaNeural, en-GB-RyanNeural, bn-BD-NabanitaNeural, bn-BD-PradeepNeural ...
TTS_VOICE=en-US-AriaNeural
TTS_RATE=+5%

# --- Server ---
HOST=0.0.0.0
PORT=8000
# Optional: the bot's own address, used by the dashboard for the local page link
DEVICE_URL=http://deskbot.local
